# Vendor documents. Not ours to redistribute, and they get revised -- the
# docs link to the vendors' own copies instead. See the table at the end of
# README.md. Keep local copies here if you like; they stay out of the repo.
docs/*.pdf

# Python
__pycache__/
*.py[cod]

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store

# A real config may hold an SMTP password, and the deployed paths are
# generated by install.sh. Only the templates belong in the repo.
etc/**/*.dist
*.local.conf
